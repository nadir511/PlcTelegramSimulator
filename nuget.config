<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-scoped NuGet configuration for the .NET backend solution.

  The machine-level NuGet.Config registers private Artifactory/GitHub feeds that
  require credentials and return HTTP 401 in this environment, which aborts
  restore for any package not already in the global cache. Everything this
  solution needs is available on nuget.org, so we clear inherited sources and
  pin to the public feed for deterministic, credential-free restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
